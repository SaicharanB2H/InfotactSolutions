{
  "name": "streamweaver-backend",
  "version": "1.0.0",
  "description": "High-Throughput No-Code ETL Pipeline Backend using Node.js Streams, MongoDB Bulk Operations, isolated-vm, and WebSockets",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/**/*.test.js",
    "memory-test": "node scripts/memory-test.js",
    "generate-csv": "node scripts/generate-csv.js"
  },
  "keywords": [
    "etl",
    "streams",
    "backpressure",
    "isolated-vm",
    "mongodb",
    "express",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "split2": "^4.2.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "isolated-vm": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
